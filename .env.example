# Copy to .env.local. Never commit secrets. NEXT_PUBLIC_* values ship to the browser.
# NWS requires an app name and a real contact address; leave blank until configured.
NWS_USER_AGENT=

# AirNow air-quality observations (free key: https://docs.airnowapi.org/). Blank = "not set up".
AIRNOW_API_KEY=

# Hackathon-hosted Glendale GIS MCP, used server-side by POST /api/v1/hazards/query.
# The shared key comes from the event organizers; blank = "not set up". Local .mcp.json uses no key.
# Without the event key: URL=http://127.0.0.1:8765/mcp, any made-up KEY, then `npm run gis:local`.
GLENDALE_GIS_MCP_URL=https://glendale-gis-mcp-1053589358088.us-west2.run.app/mcp
GLENDALE_GIS_MCP_KEY=

# Optional future accessible audio provider; no audio API is connected yet.
ELEVENLABS_API_KEY=

# Mapbox public token (pk.…) for the homepage map, its directions, and address search.
# It ships to the browser by design; restrict it to your site URLs in the Mapbox account dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Local development ONLY: permits explicit source-query demos on next dev.
# Production builds ignore this flag until rights, caching, rate limits and monitoring are reviewed.
FIREPOINT_DEMO_LIVE_SOURCES=

# Local development ONLY: shows the unverified routing prototype on the homepage (hardcoded shelters,
# invented escape targets, Mapbox Directions, automatic location prompt). Production builds, including
# Vercel Preview, ignore it and always serve the public no-data screen. Never NEXT_PUBLIC_.
FIREPOINT_PROTOTYPE_ROUTING=

# Community reporting preview API. Leave unset everywhere by default.
# Production must stay unset/off even if Neon adds DATABASE_URL to Production.
# Enable only after Preview is protected, Preview and Production Neon databases/branches are confirmed separate,
# migrations are applied to Preview, this project has no custom trusted-proxy/header ingress behavior, an external
# Preview purge or owner-verified Neon Scheduled Function Trigger deletion has been observed, and a named moderator/rights review exists.
FIREPOINT_REPORTING_ENABLED=
FIREPOINT_TENANT_ID=glendale-preview
DATABASE_URL=
FIREPOINT_ABUSE_SALT=
FIREPOINT_TRUSTED_IP_HEADER=
FIREPOINT_MODERATOR_TOKEN=
FIREPOINT_PURGE_TOKEN=
FIREPOINT_MODERATION_OWNER=
FIREPOINT_MODERATION_POLICY_VERSION=
FIREPOINT_MODERATION_AT=
FIREPOINT_REPORT_RIGHTS_REVIEWED=
