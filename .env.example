# Copy to .env.local. Never commit real credentials; all values here are server-only.
# NWS requires an app name and a real contact address; leave blank until configured.
NWS_USER_AGENT=

# AirNow air-quality observations (free key: https://docs.airnowapi.org/). Blank = "not set up".
AIRNOW_API_KEY=

# Hackathon-hosted Glendale GIS MCP, used server-side by POST /api/v1/hazards/query.
# The shared key comes from the event organizers; blank = "not set up". Local .mcp.json uses no key.
# Without the event key: URL=http://127.0.0.1:8765/mcp, any made-up KEY, then `npm run gis:local`.
GLENDALE_GIS_MCP_URL=https://glendale-gis-mcp-1053589358088.us-west2.run.app/mcp
GLENDALE_GIS_MCP_KEY=

# Optional future accessible audio provider; no audio API is connected yet.
ELEVENLABS_API_KEY=

# Mapbox public token (pk.…) for the homepage map. It ships to the browser by design;
# restrict it to your site URLs in the Mapbox account dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=
